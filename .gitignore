# downloads & build outputs
data/
# fixture for scripts/ena-test/tsv-parity.mjs, fetched on demand from the EBI
scripts/ena-test/fx/
*.syldb
# ...except the two that ARE the site: the 6 MB smoke test and the 13 MB
# screening database. Both are downloaded by the page itself, so they have to be
# in the repo — the nineteen reference databases are on Zenodo precisely because
# they are not. gut_mini.syldb was only tracked because it predated this rule;
# an untracked screening database would have deployed a site whose "which biome
# is this?" button 404s.
!web/db/gut_mini.syldb
!web/db/screening.syldb
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fasta
*.fasta.gz
*.fa
*.fa.gz

# rust / wasm
target/
pkg/
node_modules/
# NOTE: Cargo.lock is deliberately NOT ignored. This crate is built as a
# deployed artifact, not published as a library, and leaving it out let
# dependency resolution drift until the wasm32 build stopped compiling
# (unpinned `rand = "0"` reached rand 0.10 -> getrandom 0.4).

# editor
.vscode/
.idea/
*.swp
.DS_Store

# cloned upstream (kept out of our repo)
sylph-survey/sylph/

# python
__pycache__/
*.pyc
