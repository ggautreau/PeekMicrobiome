# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock IS tracked here (inherited from upstream sylph, which ignored it).
# We ship this crate as a deployed wasm artifact, so the build must be
# reproducible; see the note in the repo-root .gitignore.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
